{
  "name": "smart-planning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Planning d'equipe extrait automatiquement d'une photo ou d'un PDF, 100% local dans le navigateur.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "idb": "^8.0.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9",
    "wrangler": "^4.131.1"
  }
}
